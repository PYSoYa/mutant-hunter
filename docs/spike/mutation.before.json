","status":"Survived","static":false,"testsCompleted":3,"coveredBy":["8","9","10"],"location":{"end":{"column":48,"line":141},"start":{"column":20,"line":141}}},{"id":"100","mutatorName":"ConditionalExpression","replacement":"false","status":"Survived","static":false,"testsCompleted":3,"coveredBy":["8","9","10"],"location":{"end":{"column":48,"line":141},"start":{"column":20,"line":141}}},{"id":"102","mutatorName":"StringLiteral","replacement":"\"\"","status":"Survived","static":false,"testsCompleted":3,"coveredBy":["8","9","10"],"location":{"end":{"column":35,"line":141},"start":{"column":32,"line":141}}},{"id":"101","mutatorName":"LogicalOperator","replacement":"i.path.join(\".\") && \"(root)\"","status":"Survived","static":false,"testsCompleted":3,"coveredBy":["8","9","10"],"location":{"end":{"column":48,"line":141},"start":{"column":20,"line":141}}},{"id":"104","mutatorName":"StringLiteral","replacement":"\"\"","status":"Survived","static":false,"testsCompleted":3,"coveredBy":["8","9","10"],"location":{"end":{"column":15,"line":142},"start":{"column":11,"line":142}}},{"id":"106","mutatorName":"BlockStatement","replacement":"{}","status":"Survived","static":false,"testsCompleted":3,"coveredBy":["8","9","10"],"location":{"end":{"column":2,"line":154},"start":{"column":69,"line":147}}},{"id":"108","mutatorName":"MethodExpression","replacement":"badJson","status":"Survived","static":false,"testsCompleted":3,"coveredBy":["8","9","10"],"location":{"end":{"column":25,"line":151},"start":{"column":3,"line":151}}},{"id":"107","mutatorName":"StringLiteral","replacement":"``","status":"Survived","static":false,"testsCompleted":3,"coveredBy":["8","9","10"],"location":{"end":{"column":177,"line":153},"start":{"column":10,"line":148}}},{"id":"105","mutatorName":"StringLiteral","replacement":"``","status":"Survived","static":true,"testsCompleted":11,"coveredBy":[],"location":{"end":{"column":122,"line":145},"start":{"column":23,"line":145}}}],"source":"import { z, ZodError, ZodType } from \"zod\";\nimport { callLLM, LLMError } from \"./client\";\n\nexport class JsonGuardError extends Error {\n  readonly raw: string;\n  readonly cause?: unknown;\n  constructor(message: string, raw: string, cause?: unknown) {\n    super(message);\n    this.name = \"JsonGuardError\";\n    this.raw = raw;\n    this.cause = cause;\n  }\n}\n\nexport function extractJson(raw: string): unknown {\n  const trimmed = raw.trim();\n  const direct = tryParse(trimmed);\n  if (direct.ok) return direct.value;\n\n  const start = trimmed.indexOf(\"{\");\n  if (start === -1) {\n    throw new JsonGuardError(\"No '{' found in LLM response\", raw);\n  }\n\n  let depth = 0;\n  let inString = false;\n  let escape = false;\n  for (let i = start; i < trimmed.length; i++) {\n    const ch = trimmed[i];\n    if (escape) {\n      escape = false;\n      continue;\n    }\n    if (ch === \"\\\\\") {\n      escape = true;\n      continue;\n    }\n    if (ch === '\"') {\n      inString = !inString;\n      continue;\n    }\n    if (inString) continue;\n    if (ch === \"{\") depth++;\n    else if (ch === \"}\") {\n      depth--;\n      if (depth === 0) {\n        const slice = trimmed.slice(start, i + 1);\n        const parsed = tryParse(slice);\n        if (parsed.ok) return parsed.value;\n        throw new JsonGuardError(\n          `Failed to parse balanced JSON block: ${parsed.error}`,\n          raw,\n          parsed.error,\n        );\n      }\n    }\n  }\n\n  throw new JsonGuardError(\"Unbalanced JSON object in LLM response\", raw);\n}\n\nfunction tryParse(text: string):\n  | { ok: true; value: unknown }\n  | { ok: false; error: string } {\n  try {\n    return { ok: true, value: JSON.parse(text) };\n  } catch (err) {\n    return { ok: false, error: (err as Error).message };\n  }\n}\n\nexport type ValidateOptions = {\n  system: string;\n  user: string;\n  model?: string;\n  temperature?: number;\n};\n\nexport async function validateOrRepair<T extends ZodType>(\n  schema: T,\n  initialRaw: string,\n  opts: ValidateOptions,\n): Promise<{ value: z.infer<T>; usedRepair: boolean; raw: string }> {\n  const first = tryValidate(schema, initialRaw);\n  if (first.ok) {\n    return { value: first.value, usedRepair: false, raw: initialRaw };\n  }\n\n  const repairPrompt = buildRepairPrompt(initialRaw, first.error);\n  let repaired: string;\n  try {\n    const r = await callLLM({\n      system: REPAIR_SYSTEM,\n      user: repairPrompt,\n      model: opts.model,\n      temperature: 0,\n      jsonMode: true,\n    });\n    repaired = r.raw;\n  } catch (err) {\n    throw new JsonGuardError(\n      `Validation failed and LLM repair call errored: ${(err as LLMError).message}`,\n      initialRaw,\n      err,\n    );\n  }\n\n  const second = tryValidate(schema, repaired);\n  if (second.ok) {\n    return { value: second.value, usedRepair: true, raw: repaired };\n  }\n\n  throw new JsonGuardError(\n    `Validation failed twice. First: ${first.error}. After repair: ${second.error}`,\n    repaired,\n  );\n}\n\nfunction tryValidate<T extends ZodType>(\n  schema: T,\n  raw: string,\n):\n  | { ok: true; value: z.infer<T> }\n  | { ok: false; error: string } {\n  let parsed: unknown;\n  try {\n    parsed = extractJson(raw);\n  } catch (err) {\n    return { ok: false, error: (err as Error).message };\n  }\n  const result = schema.safeParse(parsed);\n  if (result.success) {\n    return { ok: true, value: result.data };\n  }\n  return { ok: false, error: formatZodError(result.error) };\n}\n\nfunction formatZodError(err: ZodError): string {\n  return err.issues\n    .slice(0, 5)\n    .map((i) => `${i.path.join(\".\") || \"(root)\"}: ${i.message}`)\n    .join(\"; \");\n}\n\nconst REPAIR_SYSTEM = `You fix malformed JSON. Return ONLY a single corrected JSON object. No prose, no markdown fences.`;\n\nfunction buildRepairPrompt(badJson: string, reason: string): string {\n  return `The following JSON failed validation: ${reason}\n\nOriginal JSON:\n${badJson.slice(0, 8000)}\n\nReturn ONLY the corrected JSON object that fixes the issues. Do not change semantically valid fields. Add any missing required fields with sensible defaults. Return JSON only.`;\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"tests/jsonGuard.test.ts":{"tests":[{"id":"0","name":"extractJson parses a clean JSON object"},{"id":"1","name":"extractJson extracts JSON surrounded by prose"},{"id":"2","name":"extractJson handles nested objects and strings containing braces"},{"id":"3","name":"extractJson handles strings with escaped quotes"},{"id":"4","name":"extractJson throws when no '{' is found"},{"id":"5","name":"extractJson throws when braces are unbalanced"},{"id":"6","name":"extractJson throws when block parses to invalid JSON"},{"id":"7","name":"validateOrRepair returns immediately when first response is valid (no LLM call)"},{"id":"8","name":"validateOrRepair invokes repair once when schema fails, repair returns valid"},{"id":"9","name":"validateOrRepair throws JsonGuardError when both attempts fail validation"},{"id":"10","name":"validateOrRepair does not retry beyond one repair attempt"}],"source":"import { beforeEach, describe, expect, it, vi } from \"vitest\";\nimport { z } from \"zod\";\n\nconst callLLMMock = vi.fn();\n\nvi.mock(\"@/lib/llm/client\", async () => {\n  const actual =\n    await vi.importActual<typeof import(\"@/lib/llm/client\")>(\n      \"@/lib/llm/client\",\n    );\n  return {\n    ...actual,\n    callLLM: callLLMMock,\n  };\n});\n\nconst { extractJson, JsonGuardError, validateOrRepair } = await import(\n  \"@/lib/llm/jsonGuard\"\n);\n\ndescribe(\"extractJson\", () => {\n  it(\"parses a clean JSON object\", () => {\n    expect(extractJson('{\"a\": 1, \"b\": \"x\"}')).toEqual({ a: 1, b: \"x\" });\n  });\n\n  it(\"extracts JSON surrounded by prose\", () => {\n    const raw = \"Sure thing! Here is the JSON:\\n{\\\"k\\\": 42}\\nThanks!\";\n    expect(extractJson(raw)).toEqual({ k: 42 });\n  });\n\n  it(\"handles nested objects and strings containing braces\", () => {\n    const raw = `prefix { \"a\": { \"b\": \"}{\" }, \"c\": [1,2,3] } trailing`;\n    expect(extractJson(raw)).toEqual({ a: { b: \"}{\" }, c: [1, 2, 3] });\n  });\n\n  it(\"handles strings with escaped quotes\", () => {\n    const raw = `{\"msg\": \"he said \\\\\"hi\\\\\"\"}`;\n    expect(extractJson(raw)).toEqual({ msg: 'he said \"hi\"' });\n  });\n\n  it(\"throws when no '{' is found\", () => {\n    expect(() => extractJson(\"no json here\")).toThrow(JsonGuardError);\n  });\n\n  it(\"throws when braces are unbalanced\", () => {\n    expect(() => extractJson('{\"a\": 1 ')).toThrow(JsonGuardError);\n  });\n\n  it(\"throws when block parses to invalid JSON\", () => {\n    expect(() => extractJson(\"{not, json}\")).toThrow(JsonGuardError);\n  });\n});\n\ndescribe(\"validateOrRepair\", () => {\n  const schema = z.object({\n    name: z.string(),\n    age: z.number().int().nonnegative(),\n  });\n\n  beforeEach(() => {\n    callLLMMock.mockReset();\n  });\n\n  it(\"returns immediately when first response is valid (no LLM call)\", async () => {\n    const raw = '{\"name\":\"alice\",\"age\":30}';\n    const result = await validateOrRepair(schema, raw, {\n      system: \"ignored\",\n      user: \"ignored\",\n    });\n    expect(result.usedRepair).toBe(false);\n    expect(result.value).toEqual({ name: \"alice\", age: 30 });\n    expect(callLLMMock).not.toHaveBeenCalled();\n  });\n\n  it(\"invokes repair once when schema fails, repair returns valid\", async () => {\n    const broken = '{\"name\":\"bob\",\"age\":\"not-a-number\"}';\n    callLLMMock.mockResolvedValueOnce({\n      raw: '{\"name\":\"bob\",\"age\":99}',\n      model: \"mock\",\n      promptTokens: 0,\n      completionTokens: 10,\n    });\n\n    const result = await validateOrRepair(schema, broken, {\n      system: \"ignored\",\n      user: \"ignored\",\n    });\n\n    expect(callLLMMock).toHaveBeenCalledTimes(1);\n    expect(result.usedRepair).toBe(true);\n    expect(result.value).toEqual({ name: \"bob\", age: 99 });\n  });\n\n  it(\"throws JsonGuardError when both attempts fail validation\", async () => {\n    const broken = '{\"name\":\"carol\",\"age\":\"still-bad\"}';\n    callLLMMock.mockResolvedValueOnce({\n      raw: '{\"name\":\"carol\",\"age\":\"also-bad\"}',\n      model: \"mock\",\n      promptTokens: 0,\n      completionTokens: 10,\n    });\n\n    await expect(\n      validateOrRepair(schema, broken, {\n        system: \"ignored\",\n        user: \"ignored\",\n      }),\n    ).rejects.toBeInstanceOf(JsonGuardError);\n\n    expect(callLLMMock).toHaveBeenCalledTimes(1);\n  });\n\n  it(\"does not retry beyond one repair attempt\", async () => {\n    const broken = '{\"name\":\"dan\",\"age\":\"x\"}';\n    callLLMMock.mockResolvedValue({\n      raw: '{\"name\":\"dan\",\"age\":\"y\"}',\n      model: \"mock\",\n      promptTokens: 0,\n      completionTokens: 5,\n    });\n\n    await expect(\n      validateOrRepair(schema, broken, {\n        system: \"ignored\",\n        user: \"ignored\",\n      }),\n    ).rejects.toBeInstanceOf(JsonGuardError);\n\n    expect(callLLMMock).toHaveBeenCalledTimes(1);\n  });\n});\n"}},"projectRoot":"/private/tmp/claude-501/-Users-yunseokpark-devel/5058c690-4fb6-4a23-9671-1b822951cd15/scratchpad/spike/target","config":{"$schema":"./node_modules/@stryker-mutator/core/schema/stryker-schema.json","testRunner":"vitest","vitest":{"configFile":"vitest.mutation.config.ts","related":true},"mutate":["lib/llm/jsonGuard.ts"],"concurrency":4,"coverageAnalysis":"perTest","reporters":["json","clear-text"],"jsonReporter":{"fileName":"reports/mutation.json"},"timeoutMS":15000,"tempDirName":".stryker-tmp","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https: